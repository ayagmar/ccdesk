---
import { type ImageMetadata } from "astro";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import CommandCopy from "../components/CommandCopy.astro";
import Screenshot from "../components/Screenshot.astro";

const base = import.meta.env.BASE_URL;

// The crops are taken at twice the CSS size, so each shows at half its width in pixels.
const crops = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/screenshots/answer-*-light.webp",
  { eager: true }
);
const cropWidth = (id: string) => {
  const crop = crops[`../assets/screenshots/answer-${id}-light.webp`];
  if (!crop) throw new Error(`No screenshot answer-${id}-light.webp; run pnpm screenshots`);
  return crop.default.width / 2;
};

// Questions people open ccdesk with, and the section of the app that answers each, with the key
// that jumps to it there (What Claude sees is a view, so it has none).
// Each opens to a crop of the rows that answer it (`pnpm screenshots` makes answer-<id>-*.webp).
const QUESTIONS = [
  {
    id: "ask-push",
    question: "Why does Claude ask me before every git push here?",
    answer: "The ask rule and its settings file, ready to move or remove",
    shows: "The Bash(git push *) ask rule from user settings, among the other permission rules",
    section: "Permissions",
    key: "3",
    page: "permissions/",
    title: "Permissions",
  },
  {
    id: "model",
    question: "Which model does this repository use, and who set it?",
    answer: "The value that wins, and the ones it beats",
    shows:
      "The model setting: sonnet from project settings, with user settings' opus struck through",
    section: "Settings",
    key: "2",
    page: "settings/",
    title: "Settings",
  },
  {
    id: "agents-md",
    question: "Is my AGENTS.md loaded at all?",
    answer: "Loaded, on match or skipped, with the reason",
    shows: "AGENTS.md marked skipped, because CLAUDE.md already imports it",
    section: "Instructions",
    key: "1",
    page: "instructions/",
    title: "Instructions",
  },
  {
    id: "context",
    question: "How much context does my config take before I type anything?",
    answer: "Each part in load order, with estimated tokens",
    shows:
      "What Claude sees: about 384 tokens from 9 parts, listed in load order with lines and tokens",
    section: "What Claude sees",
    key: "",
    page: "what-claude-sees/",
    title: "What Claude sees",
  },
  {
    id: "unused-allow",
    question: "Which allow rules have I stopped needing?",
    answer: "Rules that covered no call in this project's sessions, ready to remove",
    shows: "Allow rules flagged covered no call here",
    section: "Permissions",
    key: "3",
    page: "permissions/",
    title: "Permissions",
  },
  {
    id: "suggested",
    question: "What do I keep approving by hand?",
    answer: "Suggested allow rules, with how often you said yes",
    shows: "Suggested rules such as Bash(gh pr view *), which you allowed 2 times",
    section: "Permissions",
    key: "3",
    page: "permissions/#suggested-rules",
    title: "Suggested rules",
  },
  {
    id: "mcp-waiting",
    question: "Which project MCP servers still wait for approval?",
    answer: "Each server's status, scope and target",
    shows:
      "The sentry server from .mcp.json marked needs approval, beside servers that are configured",
    section: "MCP servers",
    key: "7",
    page: "mcp-servers/",
    title: "MCP servers",
  },
  {
    id: "memory-reads",
    question: "Which memories does Claude never read?",
    answer: "How often Claude read each memory, and the ones it has not read lately",
    shows:
      "The Memory timetable with reads per memory: staging-url never read, release-freeze not read in 30 days",
    section: "Memory",
    key: "5",
    page: "memory/#reads",
    title: "Memory reads",
  },
  {
    id: "shared-memory",
    question: "Did Claude save the same memory in two projects?",
    answer: "Memories found under more than one directory",
    shows: "The review-style memory, saved in acme-api and acme-web and drifted apart",
    section: "Memory",
    key: "5",
    page: "memory/",
    title: "Memory",
  },
];
---

<StarlightPage
  frontmatter={{
    title: "See and change what Claude Code loads",
    description:
      "A local web app that shows every instruction file, setting, permission rule, hook, MCP server, subagent, skill and memory Claude Code loads in a directory, with the file each comes from, and lets you change them safely.",
    template: "splash",
    hero: { title: "ccdesk" },
    editUrl: false,
    pagefind: false,
  }}
>
  <div class="landing">
    <section aria-labelledby="questions">
      <h2 id="questions">Questions it answers</h2>
      <p class="section-lede">
        Each answer is a row in ccdesk that names the file it comes from. Open a question to see
        the row and where to find it in the app.
      </p>
      <table class="timetable">
        <thead>
          <tr>
            <th scope="col">You want to know</th>
            <th scope="col">ccdesk shows</th>
            <th scope="col" class="key-col">In ccdesk</th>
          </tr>
        </thead>
        <tbody>
          {
            QUESTIONS.map((q) => (
              <Fragment>
                <tr class="question">
                  <td>
                    <button
                      type="button"
                      class="ask"
                      aria-expanded="false"
                      aria-controls={`answer-${q.id}`}
                    >
                      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                        <path d="M6 3.5 10.5 8 6 12.5" />
                      </svg>
                      {q.question}
                    </button>
                  </td>
                  <td class="answer">{q.answer}</td>
                  <td class="key-col">
                    <span class="section">{q.section}</span>
                    {q.key && <kbd title={`Press ${q.key} in ccdesk to jump here`}>{q.key}</kbd>}
                  </td>
                </tr>
                <tr class="reveal" id={`answer-${q.id}`} hidden>
                  <td colspan="3">
                    <div class="reveal-body">
                      <Screenshot
                        name={`answer-${q.id}`}
                        alt={q.shows}
                        width={cropWidth(q.id)}
                        sizes={`min(${cropWidth(q.id)}px, 100vw)`}
                      />
                      <a href={`${base}${q.page}`}>Read more in {q.title}</a>
                    </div>
                  </td>
                </tr>
              </Fragment>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="split" aria-labelledby="changes">
      <div>
        <h2 id="changes">Every change is a diff you review first</h2>
        <ul class="facts-list">
          <li>
            Settings, permission rules, hooks, MCP servers, subagents and memory can be changed.
            Instruction files open in your own editor.
          </li>
          <li>
            Settings are checked against Claude Code's own settings schema, and can be written only
            to files Claude Code reads that key from.
          </li>
          <li>
            Save writes exactly the reviewed diff. If Claude Code or your editor changed the file
            in the meantime, ccdesk asks you to review again.
          </li>
          <li>
            The old file is backed up first. Undo is one click, and
            <a href={`${base}recent-changes/`}>Recent changes</a> can restore every file ccdesk
            wrote. MCP servers changed through <code>claude mcp</code> are listed there with the
            commands that put them back.
          </li>
        </ul>
      </div>
      <Screenshot
        name="review"
        alt="The model setting open in the inspector, with the diff that changes it from sonnet to opus in the project's settings file"
        width={480}
      />
    </section>

    <section class="split check" aria-labelledby="check">
      <div>
        <h2 id="check">Fail a build when a session would read a broken file</h2>
        <p class="section-lede">
          <code>ccdesk check</code> lists the files a session started in a folder reads but Claude
          Code cannot: a settings file or <code>.mcp.json</code> that is not valid JSON, a
          settings file whose shape its schema rejects, a <code>CLAUDE.md</code> or rule it cannot read. It exits 1 when
          there are any, so run it in CI. It only reads, and counts only the repository's own
          files.
        </p>
        <p><a href={`${base}getting-started/#without-the-browser`}>Running ccdesk check in CI</a></p>
      </div>
      <pre class="terminal" tabindex="0" aria-label="ccdesk check output"><code><span class="prompt">$</span> npx ccdesk check
Claude Code cannot read these files and may skip them:
  .claude/settings.json: not valid JSON (line 4, column 3)
  .mcp.json: not valid JSON (line 2, column 1)

2 problems in a session started in ~/code/acme-api.</code></pre>
    </section>

    <section aria-labelledby="private">
      <h2 id="private">It stays on your machine</h2>
      <div class="columns">
        <p>
          The server listens on <code>127.0.0.1</code> only and needs a token made for each run.
          ccdesk makes no network requests and sends no telemetry.
        </p>
        <p>
          Values under <code>env</code> and <code>headers</code> show as <code>•••</code>, even in
          diffs. <code>~/.claude/.credentials.json</code> is never read, and
          <code>~/.claude.json</code> is never written.
        </p>
        <p>
          Transcripts are read only to count tool calls, reads of memory files and your answers to
          permission prompts. Commands, URL hosts and the paths Claude read stay inside the ccdesk process; only
          counts, times and rule patterns reach the page.
        </p>
      </div>
      <p><a href={`${base}safety-and-privacy/`}>Safety and privacy, in full</a></p>
    </section>

    <section class="last" aria-labelledby="try">
      <h2 id="try">Try it on a project you use Claude Code in</h2>
      <div class="actions">
        <CommandCopy command="npx ccdesk" />
        <a href={`${base}getting-started/`}>Getting started</a>
        <a href={`${base}interface/`}>Reading the interface</a>
        <a href={`${base}llms.txt`}>llms.txt</a>
      </div>
      <p class="note">
        ccdesk is an independent open-source project under the MIT licence. It is not made or
        endorsed by Anthropic.
      </p>
    </section>
  </div>
</StarlightPage>

<style>
  /* The splash page uses the full width the screenshots need. Starlight sizes the content column
     and lines the header's search up with it from this one variable. */
  :global(:root:has(.landing)) {
    --sl-content-width: 76rem;
  }

  .landing {
    display: grid;
    gap: 4.5rem;
    padding-bottom: 3rem;
  }

  .landing h2 {
    margin: 0;
    padding-top: 0.75rem;
    border-top: 2px solid var(--ink);
    color: var(--ink);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .section-lede {
    max-width: 64ch;
    margin: 0.5rem 0 0;
    color: var(--sl-color-gray-3);
  }

  .timetable {
    display: table;
    width: 100%;
    margin-top: 1.25rem;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .timetable th {
    padding: 0 0.5rem 0.375rem;
    border-bottom: 1px solid var(--ink);
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 600;
    text-align: left;
  }

  .timetable td {
    height: 2.75rem;
    padding: 0.375rem 0.5rem;
    border-bottom: 1px solid var(--rule);
    vertical-align: middle;
  }

  .timetable .question:hover,
  .timetable .question:has([aria-expanded="true"]) {
    background: var(--sunk);
  }

  .ask {
    display: inline-flex;
    gap: 0.5rem;
    align-items: baseline;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
  }

  .ask::before {
    position: absolute;
    inset: 0;
    content: "";
  }

  .question {
    position: relative;
  }

  .ask:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* On the first line of a question that wraps, not between its lines. */
  .ask svg {
    flex: none;
    align-self: flex-start;
    margin-top: calc((1lh - 14px) / 2);
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ask[aria-expanded="true"] svg {
    transform: rotate(90deg);
  }

  .timetable .reveal > td {
    height: auto;
    padding: 0.25rem 0.5rem 1.25rem 1.875rem;
    background: var(--sunk);
  }

  .reveal-body {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }

  .reveal-body :global(.shot) {
    width: 100%;
    margin: 0;
  }

  .reveal-body > a {
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 600;
    text-underline-offset: 0.2em;
  }

  .reveal-body.opening {
    animation: unroll 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes unroll {
    from {
      clip-path: inset(0 0 100% 0);
      opacity: 0;
      translate: 0 -0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ask svg {
      transition: none;
    }

    .reveal-body.opening {
      animation: fade 150ms linear;
    }

    @keyframes fade {
      from {
        opacity: 0;
      }
    }
  }

  .answer {
    color: var(--sl-color-gray-3);
  }

  .key-col {
    color: var(--sl-color-gray-3);
    text-align: right;
    white-space: nowrap;
  }

  .timetable th.key-col {
    text-align: right;
  }

  .key-col kbd {
    margin-left: 0.5rem;
  }

  kbd {
    display: inline-grid;
    place-items: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.3rem;
    border: 1px solid var(--rule);
    border-bottom-width: 2px;
    border-radius: 4px;
    background: var(--panel);
    color: var(--ink);
    font-family: var(--__sl-font-mono);
    font-size: 0.75rem;
  }


  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
    gap: 3.5rem;
    align-items: start;
  }

  .split :global(.shot) {
    margin: 0;
  }

  /* The output keeps its lines whole beside the text, and scrolls once the page stacks. */
  .split.check {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .terminal {
    margin: 0;
    padding: 1rem 1.125rem;
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--panel);
    color: var(--ink);
    font-family: var(--__sl-font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .terminal code {
    padding: 0;
    background: none;
    font-size: inherit;
  }

  .terminal .prompt {
    color: var(--muted);
    user-select: none;
  }

  .facts-list {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .facts-list li {
    margin: 0;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule);
    line-height: 1.55;
  }

  .facts-list li:first-child {
    padding-top: 0;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    margin-top: 1.25rem;
  }

  .columns p {
    margin: 0;
    line-height: 1.6;
  }

  section > p:last-child:not(.note) {
    margin-top: 1.25rem;
  }

  section a:not(.primary) {
    text-underline-offset: 0.2em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.25rem;
  }

  .actions a {
    color: var(--ink);
    font-weight: 600;
  }

  .note {
    margin-top: 2rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  @media (max-width: 64rem) {
    .split,
    .split.check,
    .columns {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 40rem) {
    .landing {
      gap: 3.5rem;
    }

    .timetable thead {
      display: none;
    }

    .timetable tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      padding: 0.625rem 0;
      border-bottom: 1px solid var(--rule);
    }

    .timetable td {
      height: auto;
      padding: 0;
      border: 0;
    }

    .timetable .answer {
      grid-row: 2;
      font-size: 0.875rem;
    }

    .timetable .key-col {
      margin-top: 0.375rem;
      padding-left: 1.375rem;
      font-size: 0.8125rem;
      text-align: left;
    }

    .timetable .answer {
      padding-left: 1.375rem;
    }

    .timetable .reveal {
      display: block;
      padding: 0 0.5rem 1rem;
      background: var(--sunk);
    }

    .timetable .reveal[hidden] {
      display: none;
    }

    .timetable .reveal > td {
      display: block;
      padding: 0;
    }
  }
</style>

<script>
  // Each question opens the row below it, which holds the crop that answers it.
  for (const button of document.querySelectorAll<HTMLButtonElement>(".timetable .ask")) {
    const row = document.getElementById(button.getAttribute("aria-controls") ?? "");
    if (!row) continue;
    button.addEventListener("click", () => {
      const open = button.getAttribute("aria-expanded") !== "true";
      button.setAttribute("aria-expanded", String(open));
      row.hidden = !open;
      const body = row.querySelector(".reveal-body");
      body?.classList.remove("opening");
      if (open) body?.classList.add("opening");
    });
  }
</script>
