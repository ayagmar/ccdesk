---
// Starlight's head, with the favicon made from Murmeli's badge and the repository's social
// preview as the share image, both resolved against `site` and `base`.
import { getImage } from "astro:assets";
import preview from "../../../.github/social-preview.png";
import logo from "../../../assets/brand/logo.png";

const favicon = await getImage({ src: logo, width: 64, height: 64, format: "png" });
const share = new URL(preview.src, Astro.site).href;
const { head } = Astro.locals.starlightRoute;
---

{
  head.map(({ tag: Tag, attrs, content }) =>
    Tag === "link" && attrs?.rel === "shortcut icon" ? (
      <link rel="icon" href={favicon.src} type="image/png" />
    ) : (
      <Tag {...attrs} set:html={content} />
    )
  )
}
<meta property="og:image" content={share} />
<meta property="og:image:width" content={String(preview.width)} />
<meta property="og:image:height" content={String(preview.height)} />
<meta name="twitter:image" content={share} />
