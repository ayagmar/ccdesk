---
// Starlight's site title, with Murmeli's badge resized for the header: Starlight's own logo option
// serves the 512px original to show it at 40px.
import { Image } from "astro:assets";
import logo from "../../../assets/brand/logo.png";

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
  <Image src={logo} alt="" width={40} height={40} densities={[1, 2]} format="webp" loading="eager" />
  <span translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: var(--sl-nav-gap);
    font-size: var(--sl-text-h4);
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }

  span {
    overflow: hidden;
  }

  img {
    height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
    width: auto;
  }
</style>
