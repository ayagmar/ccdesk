---
// A screenshot from src/assets/screenshots in both themes; CSS shows the one matching the page.
// Regenerate them with `pnpm screenshots`. Each image links to its full-size original.
import { getImage, Image } from "astro:assets";
import { type ImageMetadata } from "astro";

interface Props {
  name: string;
  alt: string;
  caption?: string;
  /** Rendered width in CSS pixels at most; phone shots are narrower. */
  width?: number;
  loading?: "lazy" | "eager";
}

const shots = import.meta.glob<{ default: ImageMetadata }>("../assets/screenshots/*.webp", {
  eager: true,
});
const { name, alt, caption, width = 1600, loading = "lazy" } = Astro.props;
const find = (theme: string) => {
  const shot = shots[`../assets/screenshots/${name}-${theme}.webp`];
  if (!shot) throw new Error(`No screenshot ${name}-${theme}.webp; run pnpm screenshots`);
  return shot.default;
};
const widths = [Math.round(width / 2), width, Math.min(width * 2, find("light").width)];
const sizes = `(min-width: 72rem) ${Math.min(width, 1100)}px, 100vw`;
// The original's own URL works in a build but not as a page in `astro dev`, so link to a copy.
const full = {
  light: (await getImage({ src: find("light"), format: "webp", quality: 80 })).src,
  dark: (await getImage({ src: find("dark"), format: "webp", quality: 80 })).src,
};
---

<figure class="shot" style={`max-width: ${width}px`}>
  {
    (["light", "dark"] as const).map((theme) => (
      <a class={theme} href={full[theme]} title="Open the full-size image">
        <Image
          src={find(theme)}
          alt={alt}
          widths={widths}
          sizes={sizes}
          format="webp"
          quality={80}
          loading={loading}
        />
      </a>
    ))
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>
