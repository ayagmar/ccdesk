---
// A shell command with a button that copies it.
interface Props {
  command: string;
}
const { command } = Astro.props;
---

<div class="command">
  <code><span class="prompt" aria-hidden="true">$</span> {command}</code>
  <button type="button" data-copy={command} aria-label={`Copy ${command}`}>
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
      <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
      <path d="M10.5 5.5V3.75A1.25 1.25 0 0 0 9.25 2.5h-5.5A1.25 1.25 0 0 0 2.5 3.75v5.5a1.25 1.25 0 0 0 1.25 1.25H5.5" />
    </svg>
    <span data-label>Copy</span>
  </button>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    const label = button.querySelector<HTMLElement>("[data-label]");
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        if (label) label.textContent = "Copied";
      } catch {
        if (label) label.textContent = "Select and copy";
      }
      setTimeout(() => {
        if (label) label.textContent = "Copy";
      }, 1600);
    });
  }
</script>

<style>
  .command {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--panel);
    font-size: 1rem;
  }

  code {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.875rem;
    background: none;
    color: var(--ink);
    font-family: var(--__sl-font-mono);
    font-size: 1rem;
    white-space: nowrap;
  }

  .prompt {
    color: var(--muted);
    user-select: none;
  }

  button {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0 0.75rem;
    border: 0;
    border-left: 1px solid var(--rule);
    border-radius: 0 6px 6px 0;
    background: none;
    color: var(--sl-color-gray-3);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }

  button:hover {
    background: var(--sunk);
    color: var(--ink);
  }

  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
