{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["ES2023"],
    "sourceMap": false,
    "declaration": true
  },
  "include": ["src/core/**/*.ts", "src/server/**/*.ts", "src/shared/**/*.ts", "src/view/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/ui"]
}
